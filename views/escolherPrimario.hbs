
<div class="container">
    <div class="row">
        <div class="col-md-12">

            <h3 class="text-center">Gerenciar Veículos</h3>

            <form action="/veiculo/gerenciar_salvar" method="POST">

                <div id="container-veiculo">

                    {{#each veiculos}}
                        <div class="row mt-3 veiculo-item">
                            
                            <div class="col-md-12">
                                <p class="text-center">Modelo: {{this.modelo}}</p>
                            </div>

                            <div class="col-md-12">
                                <p class="text-center">Placa: {{this.placa}}</p>
                            </div>

                            <div class="col-md-4">
                                <p class="text-end form-check-label">É primário?</p>
                            </div>

                            <div class="col-md-8">
                                <input 
                                    class="form-check-input"
                                    type="radio"
                                    name="primario"
                                    value="{{this.idtb_veiculo}}"
                                    {{#if (eq this.primario 1)}}checked{{/if}}
                                    required
                                >
                            </div>

                        </div>
                    {{/each}}

                </div>

                <div class="col-sm-12 text-center">
                    <br>
                </div>

                <div class="col-sm-12 text-center">
                    <button class="btn btn-primary" type="submit">Salvar</button>
                </div>

            </form>

        </div>
    </div>
</div>

