
<style>
    /* Força o fundo em qualquer tag header ou classe topbar */
    header, .topbar {
        background-color: #001f33 !important; /* Azul bem escuro do seu projeto */
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        width: 100%;
    }

    /* Estilo do corpo da página */
    .bg-dark-custom {
        background-color: #001f3f; /* Azul marinho de fundo */
        color: white;
        min-height: 100vh;
        margin: 0;
    }

    /* Remove bordas brancas indesejadas de imagens do Bootstrap */
    .img-thumbnail {
        background-color: transparent !important;
        border: none !important;
        padding: 0 !important;
    }

   /* Estilo do ícone de perfil na direita (Imagem PNG/JPG) */
.perfil-icon {
    border-radius: 50%;
    
    /* FILTRO MÁGICO PARA DEIXAR BRANCO */
    filter: invert(100%); /* Transforma cores escuras em claras */
    
    width: 35px;
    height: 35px;
    object-fit: cover;
    transition: transform 0.2s, filter 0.2s;
}

.perfil-icon:hover {
    transform: scale(1.1);
    
    /* AJUSTE NO HOVER: Deixa um pouco mais brilhante */
    filter: invert(100%) brightness(1.2);
}

    /* Ajuste para garantir que o link não tenha sublinhado */
    .top-actions a {
        text-decoration: none;
    }
</style>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{title}}</title>

    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/navBar.css" />

    <link 
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
        crossorigin="anonymous"
    />
</head>
<body class="bg-dark-custom"> <header class="topbar" style="margin-top: 20px;">
        <div class="container-fluid d-flex align-items-center justify-content-between py-2 px-4 px-md-3">            
            <div class="logo-container">
                <a href="/"> 
                    <img src="/images/otimiroute _branco_png.png" alt="OtimiRoute" width="120" height="80" />
                </a>       
            </div>

            <div class="top-actions">
                <a class="perfil-link" href="/usuario/perfil">
                    <img src="/images/profile.png" alt="Perfil" class="perfil-icon" width="35" height="35" />
                </a>
            </div>

        </div>
    </header>

    <main>
        {{{body}}}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>