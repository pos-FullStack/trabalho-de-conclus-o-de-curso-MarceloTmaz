<style>
  body {
        background-color: #999999; /* Cor cinza do fundo da página */
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: sans-serif;
    }
    .btn-login {
        background-color: transparent;
        border: 2px solid white;
        color: white;
        border-radius: 15px;
        padding: 8px 0;
        width: 100%;
        max-width: 200px;
        margin: 0 auto;
        display: block;
        font-weight: bold;
        text-transform: uppercase;
        transition: 0.3s;
    }

    .btn-login:hover {
        background-color: white;
        color: black;
    }
     .card-editar {
        background-color: var(--bg-dark);
        padding: 40px 60px;
        border-radius: 30px;
        width: 100%;
        max-width: 500px;
        color: var(--text-white);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .logo-container_img {
        text-align: center;
        margin-bottom: 30px;
    }

    .logo-container_img img {
        width: 180px; /* Ajuste conforme sua imagem */
    }
</style>


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 card-cadastro">
            
            <div class="logo-container_img">
                <img src="/images/otimiroute _branco_png.png" alt="OtimiRoute">
                <h3 class="mt-3">Atualizar Meus Dados</h3>
            </div>

            <form action="/usuario/atualizar" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="id" value="{{id}}">

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Nome</label>
                            <input class="form-control" type="text" name="nome" placeholder="Seu nome" required value="{{nome}}">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Telefone</label>
                            <input class="form-control" type="tel" name="telefone" id="telefone" placeholder="(00) 00000-0000" required value="{{telefone}}">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nova Foto de Perfil</label>
                            <input class="form-control" type="file" name="foto" accept=".jpg,.jpeg,.png">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Nova Senha</label>
                            <input class="form-control" type="password" name="senha" id="senha">
                            <p id="necessario" class="text-danger small"></p>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirme a Nova Senha</label>
                            <input class="form-control" type="password" name="senha2">
                        </div>

                        <div class="text-center mt-4">
                            <p class="info-senha">Caso não queira alterar a senha, deixe os campos vazios.</p>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12 text-center d-flex justify-content-center gap-3">
                        <a href="/usuario/perfil" class="btn-login">Cancelar</a>
                        <button type="submit" class="btn-login">Atualizar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="module" src="/js/atualizarUsario.js"></script>
<script type="module" src="/js/senha_apenas_um.js"></script>
<script src="/js/formatar_telefone.js"></script>




