<style>
    /* Estilização baseada na imagem */
    .bg-dark-custom {
        background-color: #001f3f; /* Azul marinho profundo da imagem */
        min-height: 100vh;
        color: white;
        padding: 20px;
        font-family: sans-serif;
    }

    .otimi-card {
        background-color: #001f33;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 15px;
        padding: 30px;
        max-width: 800px;
        margin: 0 auto;
    }

    .form-label-custom {
        font-size: 1.2rem;
        margin-bottom: 8px;
        display: block;
    }

    .form-control-custom {
        background-color: #d1d5db !important; /* Cinza claro dos inputs na imagem */
        border: none;
        border-radius: 8px;
        height: 45px;
        margin-bottom: 20px;
        width: 100%;
        color: #333;
        padding: 10px;
    }

    .btn-outline-custom {
        background: transparent;
        border: 1px solid white;
        color: white;
        border-radius: 8px;
        padding: 10px 20px;
        transition: 0.3s;
        text-align: center;
        width: 100%;
        max-width: 250px;
        cursor: pointer;
        margin-bottom: 15px;
    }

    .btn-outline-custom:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .header-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    /* Estilo para o item de exclusão */
    .delete-btn {
        background: none;
        border: none;
        color: #ff4d4d;
        cursor: pointer;
    }
</style>

<div class="bg-dark-custom">
    <div class="container" style="margin-top: 150px;">
        

        <div class="otimi-card">
            <form action="/combustivel/gerenciar_salvar" method="POST">
                <input type="hidden" name="id" value="{{id}}">

                <div id="container-combustiveis">
                    {{#each combustiveis}}
                    <div class="combustivel-item mb-5" style="border-bottom: 1px dashed rgba(255,255,255,0.1); padding-bottom: 20px;">
                        
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label-custom">Consumo (KM/L)</label>
                                <input type="number" step="0.1" class="form-control-custom" 
                                    name="combustiveis[{{@index}}][consumo]" value="{{consumo_km}}" placeholder="12.5" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">Preço</label>
                                <input type="number" step="0.01" class="form-control-custom" 
                                    name="combustiveis[{{@index}}][preco]" value="{{preco}}" placeholder="6.79" required>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label-custom">Combustível ({{inc @index}})</label>
                                <select class="form-control-custom" name="combustiveis[{{@index}}][nome]" required>
                                    <option value="">Selecione</option>
                                    {{#each ../busca}}
                                        <option value="{{this.nome}}" {{#if (eq this.nome ../tipo_combustivel)}}selected{{/if}}>
                                            {{this.nome}}
                                        </option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 mt-2">
                            <div class="form-check">
                               <input class="form-check-input" type="radio" 
                                    name="combustiveis_primario" 
                                    value="{{this.idtb_combustivel}}" 
                                    {{#if (eq this.e_primario 1)}}checked{{/if}}>
                                <label class="text-white">É primário?</label>    
                            </div>
                            <button type="button" class="delete-btn" onclick="removerCombustivel(this, {{idtb_combutivel}})">
                                <small>Excluir</small>
                            </button>
                        </div>
                        
                        <input type="hidden" name="combustiveis[{{@index}}][referencial]" value="{{idtb_combustivel}}">
                    </div>
                    {{/each}}
                </div>

                <div class="mt-4">
                    <button id="add-parada" type="button" class="btn-outline-custom d-block" onclick="adicionarCombustivel()">
                        Adicionar combustível
                    </button>
                    
                    <button type="submit" class="btn-outline-custom d-block">
                        Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>

    window.combustiveisBack = {{{json busca}}};

    console.log("combustiveisBack carregado:", window.combustiveisBack);

</script>



<script>

    window.combustiveis = {{{json combustiveis}}};

</script>



<script>

    window.ultimoId = {{{json ultimoId}}};

</script>



<script src="/js/adicionarCombutivel.js"></script>

<script type="module" src="/js/removerCombutivel.js"></script>